PORT=3000
# Railway MySQL: en el servicio backend usa la referencia ${{MySQL.MYSQL_URL}} (red privada)
DATABASE_URL=mysql://root:password@localhost:3306/cora
# Alternativa a DATABASE_URL (variables automaticas de Railway)
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
# Secret que configuras en Vapi (Assistant > Advanced > Server URL Secret). Vacio = sin validacion (solo para pruebas locales)
VAPI_SERVER_SECRET=
# Nombre del header donde Vapi manda el secret. Default: x-vapi-secret
VAPI_SECRET_HEADER=x-vapi-secret
# API key privada de Vapi (Dashboard > Organization > API Keys). Necesaria para la sincronizacion historica
VAPI_API_KEY=
# Clave propia para proteger el endpoint de sincronizacion (header x-admin-key)
ADMIN_API_KEY=cambia-esto
